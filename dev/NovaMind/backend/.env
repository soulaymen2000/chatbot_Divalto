SECRET_KEY=novamind-dev-secret-key-change-in-production-xyz123
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
ENVIRONMENT=development

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:admin@localhost:5432/infolib

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

FRONTEND_URL=http://localhost:3000

# ─── RAG Pipeline ─────────────────────────────────────────────────────────────
# Qdrant vector database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=novamind_docs
# Local GGUF model path
RAG_LLAMA_MODEL_PATH=C:\models\qwen2.5-3b-instruct.Q4_K_M.gguf
# Embedding model (HuggingFace hub or local)
RAG_EMBEDDING_MODEL=BAAI/bge-m3
# Device: auto | cpu | cuda
RAG_DEVICE=auto
# Number of chunks to return to the user
RAG_DEFAULT_K=3

# Qwen generation parameters
RAG_MAX_TOKENS=500
RAG_TEMPERATURE=0.7
RAG_CONTEXT_WINDOW=4096
# Generation timeout in seconds
RAG_TIMEOUT=30

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ASK=10/m
RATE_LIMIT_LOGIN=5/m
RATE_LIMIT_SIGNUP=2/m

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=DEBUG

# ─── Gemini (legacy — kept for compatibility) ─────────────────────────────────
GEMINI_API_KEY=AIzaSyCCLQaZJzSnlKqkkbfBBvTk6tn_zSqECLc
GEMINI_MODEL=gemini-flash-latest
